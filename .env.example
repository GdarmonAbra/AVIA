# Copy to .env and fill in. Never commit .env.

# ─── Anthropic (required for every agent) ────────────────────────────────────
ANTHROPIC_API_KEY=
AVIA_MODEL_DEFAULT=claude-opus-4-7
AVIA_MODEL_FAST=claude-sonnet-4-6

# ─── MCP registry ────────────────────────────────────────────────────────────
# Path to mcp.json; defaults to mcp-clients/mcp.json at the repo root.
AVIA_MCP_CONFIG=mcp-clients/mcp.json

# ─── azure-devops MCP (microsoft/azure-devops-mcp) ───────────────────────────
ADO_ORG=your-org

# ─── xpp-author MCP (ccampora/mcp_xpp) ───────────────────────────────────────
# Clone and build per its README; point at the directory that contains build/index.js.
MCP_XPP_PATH=

# ─── d365fo-nav MCP (dynamics365ninja/d365fo-mcp-server) ─────────────────────
MCP_D365FO_NAV_PATH=

# ─── fo-semantic MCP (xplusplusai/fo-semantic-mcp, commercial) ───────────────
FOINDEX_API_KEY=

# ─── Shared D365 dev box paths ───────────────────────────────────────────────
# Path to PackagesLocalDirectory (xpp-author + d365fo-nav + fo-semantic all consume this).
AVIA_D365_METADATA_PATH=

# ─── erp MCP (Microsoft Dynamics 365 ERP MCP, dynamic / preview) ─────────────
# URL is https://<env>.operations.dynamics.com/mcp
D365_ERP_MCP_URL=
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_RESOURCE=https://your-env.operations.dynamics.com
