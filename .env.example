# Copy to .env and fill in. Never commit .env.

# ─── Anthropic (required for every agent) ────────────────────────────────────
ANTHROPIC_API_KEY=
AVIA_MODEL_DEFAULT=claude-opus-4-7
AVIA_MODEL_FAST=claude-sonnet-4-6

# ─── Azure DevOps (Summary, Architect, orchestrator input) ───────────────────
ADO_ORG_URL=https://dev.azure.com/your-org
ADO_PROJECT=your-project
ADO_PAT=

# ─── Dynamics 365 F&O (Tester agent + d365-runtime MCP) ──────────────────────
D365_BASE_URL=https://your-env.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_RESOURCE=https://your-env.operations.dynamics.com

# ─── X++ dev box bridge (Developer agent + xpp MCP) ──────────────────────────
# Path to the D365 tools install (contains Microsoft.Dynamics.AX.Metadata.dll etc).
# Leave unset in CI → Avia.Xpp.Cli falls back to InMemoryMetadataProvider.
AVIA_D365_TOOLS_PATH=
AVIA_D365_METADATA_PATH=
AVIA_XPP_MODEL_DEFAULT=AviaCustomizations
